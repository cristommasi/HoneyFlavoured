{
  "schemaVersion": 1,
  "id": "honeyflavoured",
  "version": "${version}",
  "name": "Honey Flavoured",
  "description": "Tweaks to change some stagnant functionalities, add parity across enchantments and game logic, and new enchantments.",
  "authors": ["cristommasi"],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.honeyflavoured.HoneyFlavoured"
    ],
    "client": [
      "com.honeyflavoured.HoneyFlavouredClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  },
  "mixins": [
    "mixins/honeyflavoured.farming.mixins.json",
    "mixins/honeyflavoured.xp.mixins.json",
    "mixins/honeyflavoured.bundles.mixins.json",
    "mixins/honeyflavoured.tools.mixins.json",
    "mixins/honeyflavoured.armor.mixins.json",
    "mixins/honeyflavoured.enchantments.mixins.json",
    "mixins/honeyflavoured.animalarmor.mixins.json",
    "mixins/honeyflavoured.anvil.mixins.json",
    "mixins/honeyflavoured.mounts.common.mixins.json",
    { "config": "mixins/honeyflavoured.mounts.mixins.json", "environment": "client" }
  ]
}

