
{
	"schemaVersion": 1,
	"id": "honeyflavoured",
	"version": "${version}",
	"name": "Honey Flavoured",
	"description": "Tweaks to change some stagnant functionalities, add parity across enchantments and game logic, and new enchantments.",
	"authors": ["cristommasi"],
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.honeyflavoured.HoneyFlavoured"
		],
		"client": [
			"com.honeyflavoured.HoneyFlavouredClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"mixins": [

		"mixins/honeyflavoured/farming.json",

		"mixins/honeyflavoured/xp.json",

		"mixins/honeyflavoured/anvil.json",

		"mixins/honeyflavoured/bundles.json",

		"mixins/honeyflavoured/tools.json",

		"mixins/honeyflavoured/armor.json",

		"mixins/honeyflavoured/enchantments.json",

		"mixins/honeyflavoured/animalarmor.json",
		{
			"config": "mixins/honeyflavoured/animalarmor.client.json",
			"environment": "client"
		},

		"mixins/honeyflavoured/mountswim.json",
		{
			"config": "mixins/honeyflavoured/mountswim.client.json",
			"environment": "client"
		},

		"mixins/honeyflavoured/mountcall.json"
	]
}
